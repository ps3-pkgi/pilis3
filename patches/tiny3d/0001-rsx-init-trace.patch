 void rsxtiny_MakeCmdSpace(tiny_gcmContextData *context, u32 space) {
+	/* Let the SDK's own context callback handle a full buffer: it is the only
+	 * thing that knows how to wrap this FIFO. An earlier attempt replaced it
+	 * with a silent rewind, which left put behind get and parked the RSX. */
+	if (!context) return;
 	INTERNAL_COMMAND_LENGTH(context, space);
 }
 
