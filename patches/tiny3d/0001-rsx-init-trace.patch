+static void tiny3d_flip_handler(const u32 head);
+
+/* Write a backend label and wait for the RSX to echo it back. This is the only
+ * dependable "is the RSX still executing commands" probe: put/get can look
+ * drained while the RSX has actually stopped. */
+static int tiny3d_label_sync(const char *tag)
+{
+    static u32 value;
+    volatile u32 *label;
+    int ms = 0;
+
+    value = (value == 0) ? 0x5a5a5a5a : (value + 1);
+    label = (volatile u32 *) gcmGetLabelAddress(255);
+    rsxtiny_SetWriteBackendLabel(context, 255, value);
+    rsxtiny_FlushBuffer(context);
+    while (ms < 200 && *label != value) { usleep(1000); ++ms; }
+    rsx_tracef("t3d %s label=%x want=%x after %d ms", tag, (unsigned) *label,
+               (unsigned) value, ms);
+    return (*label == value);
+}
