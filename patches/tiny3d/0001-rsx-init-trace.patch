 void waitFlip() { // Block the PPU thread untill the previous flip operation has finished.
+/* Back to the upstream 2 s budget (10000 x 200us). With gcmSetWaitFlip()
+ * restored in flip(), the RSX itself waits at the flip point and this is only
+ * the safety net -- shortening it to 33 ms made a slow flip look "done". */
 int n = 10000;
 	while(n>0){
         volatile int ret= gcmGetFlipStatus();
@@ -140,9 +304,20 @@ int n = 10000;
     if(n<=0) {tiny3d_alarm(5);return;} // fatal error
 }
 
+/* cellGcmGetFlipStatus() only tracks flips once a flip handler has been
+ * registered; without one it stays at 1, which made waitFlip() spin for its
+ * whole timeout on every frame. The handler itself does nothing. */
+static void tiny3d_flip_handler(const u32 head) { (void) head; }
+
 void flip(s32 buffer) {
 	gcmSetFlip((gcmContextData *) context, buffer);
 	rsxtiny_FlushBuffer(context);
+	/* Restored: parks the RSX at the flip point until the flip completes, so
+	 * the next frame's commands cannot overwrite the buffer being scanned
+	 * out. The earlier removal was a workaround for the FIFO that could never
+	 * satisfy a 64 KB MakeCmdSpace() request (get pinned at 0x200000); that
+	 * root cause is fixed (cmdSize 0x40000, reservations 0x1000), and flips
+	 * complete in ~10 ms, so the wait should no longer park forever. */
 	gcmSetWaitFlip((gcmContextData *) context); // Prevent the RSX from continuing until the flip has finished.
 }
 
